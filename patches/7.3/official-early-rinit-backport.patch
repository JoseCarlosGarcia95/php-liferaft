+	smart_str_append(buf, class_name);
+	smart_str_appendl(buf, "\":", 2);
+	smart_str_append_unsigned(buf, Z_STRLEN_P(payload));
+	smart_str_appendl(buf, ":{", 2);
+	smart_str_append(buf, Z_STR_P(payload));
+	smart_str_appendc(buf, '}');
+	zend_string_release_ex(class_name, 0);
+	return 1;
